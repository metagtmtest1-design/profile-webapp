# Copy to .dev.vars for local wrangler pages dev
# This file is gitignored

# Google Service Account JSON (stringified)
# GCAL_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"...","token_uri":"https://oauth2.googleapis.com/token"}

# Resend
# RESEND_API_KEY=re_xxxx

# Turnstile
# TURNSTILE_SECRET_KEY=0x...
# TURNSTILE_SITE_KEY is public, put in wrangler.toml vars or .env

# Admin Auth — Cloudflare Zero Trust Google login only (no password)
# ADMIN_BYPASS=true allows admin without CF Access JWT (for local/Docker/alpha preview)
# In production MUST be false — Access will enforce Google login at edge
ADMIN_BYPASS=true

# ADMIN_EMAILS — allowlist of admin emails (comma-separated, PII) — Encrypted Secret via Dashboard in alpha/prod
# Example: ADMIN_EMAILS="admin@example.com, owner@company.com"
# When empty, any email with valid CF Access JWT is allowed; when set, only listed emails allowed
# For local dev can be empty or set via this file
ADMIN_EMAILS=admin@example.com

ENVIRONMENT=local
